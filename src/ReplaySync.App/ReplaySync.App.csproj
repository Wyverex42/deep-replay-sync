<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app. The sync engine is in src/ReplaySync, shared with the console. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeepReplaySync</AssemblyName>
    <RootNamespace>DeepReplaySync</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\ReplaySync\ReplaySync.csproj" />
  </ItemGroup>
</Project>
