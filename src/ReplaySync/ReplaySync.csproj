<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Keeps the Deepchart replay from getting ahead of the Deepdom replay: the sync engine and its console front end.
    The desktop app (src/ReplaySync.App) uses the same engine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepReplaySync" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
