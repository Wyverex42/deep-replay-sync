<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Keeps the Deepchart replay from getting ahead of the Deepdom replay: the sync engine and its console front end.
    The desktop app (src/ReplaySync.App) uses the same engine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 10 2004: window capture without the cursor, which the screen clocks use. Borderless on Windows 11 -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepReplaySync" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
